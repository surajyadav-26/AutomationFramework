# Copy to .env (gitignored) and fill in. config/<TEST_ENV>.env holds URLs only.
TEST_ENV=qa
# saucedemo password shared by all UI users
APP_PASSWORD=
# dummyjson password for the API user
API_PASSWORD=

# Delete application-YYYY-MM-DD.log files older than this many days (0 = keep forever)
LOG_RETENTION_DAYS=7
# Playwright trace: off | on | retain-on-failure (open with: playwright show-trace <trace.zip>)
TRACE_MODE=retain-on-failure
# Playwright video: off | on | retain-on-failure
VIDEO_MODE=retain-on-failure

# Build and open the Allure report in the browser when the run ends (ignored when CI is set).
# Needs the Allure CLI on PATH.
ALLURE_AUTO_OPEN=true
# Report theme: dark | light
ALLURE_THEME=dark

# Accessibility tests fail on axe violations at or above this impact: minor | moderate | serious | critical
# (lower impacts are still attached to the Allure report)
A11Y_FAIL_IMPACT=serious

# API request timeout in seconds
API_TIMEOUT=15
# live = real dummyjson (default); stub = in-process fake for offline runs (proves test logic only)
API_MODE=live
# Reruns after infrastructure errors only (timeouts, connection errors); 0 disables
RERUN_COUNT=1
RERUN_DELAY=1

# Visual comparison ignores differences only 1-2 pixels wide (font/edge anti-aliasing noise).
# Off by default: it also hides real 1px changes such as a border colour.
VISUAL_IGNORE_ANTIALIASING=false
